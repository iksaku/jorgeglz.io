---
// Enhances fenced code blocks (shiki renders them as `pre.astro-code`) with a
// chrome bar: language label on the left, copy-to-clipboard button on the
// right. Inline code is untouched.
---

<script>
  const ICON_COPY = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`

  // navigator.clipboard requires a secure context; the textarea fallback keeps
  // the button working over plain-HTTP previews (e.g. tailscale).
  async function copyText(text: string): Promise<boolean> {
    try {
      if (window.isSecureContext && navigator.clipboard) {
        await navigator.clipboard.writeText(text)
        return true
      }
    } catch {
      /* fall through to execCommand */
    }
    const ta = document.createElement('textarea')
    ta.value = text
    ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none'
    document.body.appendChild(ta)
    ta.select()
    try {
      return document.execCommand('copy')
    } catch {
      return false
    } finally {
      ta.remove()
    }
  }

  function enhance(pre: HTMLElement) {
    const code = pre.querySelector('code')
    if (!code) return

    // The pre scrolls horizontally (shiki sets overflow-x), so the bar must
    // live in a wrapper, not inside the pre.
    const frame = document.createElement('div')
    frame.className = 'code-frame'
    pre.before(frame)
    frame.appendChild(pre)

    const bar = document.createElement('div')
    bar.className = 'code-frame-bar'

    const lang = document.createElement('span')
    lang.className = 'code-frame-lang'
    lang.textContent = pre.dataset.language ?? 'code'

    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'code-frame-copy'
    const label = document.createElement('span')
    label.textContent = 'Copy'
    button.innerHTML = ICON_COPY
    button.appendChild(label)

    let timer: number | undefined
    button.addEventListener('click', async () => {
      const ok = await copyText(code.textContent ?? '')
      clearTimeout(timer)
      label.textContent = ok ? 'Copied!' : 'Failed'
      button.classList.toggle('copied', ok)
      timer = window.setTimeout(() => {
        label.textContent = 'Copy'
        button.classList.remove('copied')
      }, 1600)
    })

    bar.append(lang, button)
    frame.prepend(bar)
  }

  document.querySelectorAll<HTMLElement>('.prose pre.astro-code').forEach(enhance)
</script>
