---
import { getImage } from 'astro:assets'
import type { DateTime } from 'luxon'
import type { BlogPost } from '~/lib/utils'
import Avatar from '~/assets/avatar.jpeg'

interface Props {
  title?: BlogPost['data']['title']
  description?: BlogPost['data']['description']
  image?: BlogPost['data']['image']
  article?: {
    published_time?: DateTime
    modified_time?: DateTime
  }
  twitter?: {
    card?: 'summary' | 'summary_large_image'
  }
  robots?: string
}

const {
  title = 'JorgeGlz',
  description = 'Hello! I have a blog! And here you can find... Well... Blog posts...',
  article,
  twitter,
  robots,
} = Astro.props

const SITE_NAME = 'JorgeGlz'
const SITE_LOCALE = 'en_US'
const AUTHOR_NAME = 'Jorge González'
const AUTHOR_URL = new URL('/about', Astro.site ?? Astro.url).toString()

function tabTitle(): string {
  if (title.endsWith('JorgeGlz')) {
    return title
  }

  return `${title} | JorgeGlz`
}

function metaType(): string {
  if (!!article) return 'article'

  return 'website'
}

const image = await getImage({ src: Astro.props.image ?? Avatar, format: 'jpg' })
const imageUrl = new URL(image.src, Astro.url).toString()
const imageAlt = Astro.props.image ? `${title} header image` : "Jorge González's avatar"

const articleStructuredData = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      ...(Astro.props.image ? { image: imageUrl } : {}),
      ...(article.published_time ? { datePublished: article.published_time.toISO() } : {}),
      ...(article.modified_time ? { dateModified: article.modified_time.toISO() } : {}),
      author: [{ '@type': 'Person', name: AUTHOR_NAME, url: AUTHOR_URL }],
      mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.toString() },
    }
  : null
---

<title>{tabTitle()}</title>
<link rel="canonical" href={Astro.url} />

<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={metaType()} />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={SITE_LOCALE} />

<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={`${image.attributes.width}`} />
<meta property="og:image:height" content={`${image.attributes.height}`} />
<meta property="og:image:alt" content={imageAlt} />

{
  !!article && (
    <Fragment>
      <meta property="article:author" content={AUTHOR_URL} />
      {!!article.published_time && <meta property="article:published_time" content={article.published_time.toISO()} />}
      {!!article.modified_time && <meta property="article:modified_time" content={article.modified_time.toISO()} />}
    </Fragment>
  )
}

<meta name="twitter:card" content={twitter?.card ?? (!Astro.props.image ? 'summary' : 'summary_large_image')} />
<meta name="twitter:site" content="@iksaku2" />
<meta name="twitter:creator" content="@iksaku2" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{
  articleStructuredData && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  )
}
