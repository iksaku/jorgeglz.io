---
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import Layout from '~/layouts/Blog.astro'
import Seo from '~/components/Seo.astro'
import { type BlogEntry, type BlogPost, getBlogPosts } from '~/lib/utils'

export async function getStaticPaths() {
  const posts = await getBlogPosts((post) => import.meta.env.DEV || !!post.data.date)

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: BlogPost
}

const post = Astro.props.post

// BlogPost widens data.date to a luxon DateTime for templating; render() only
// reads id/collection/rendered at runtime, so narrow it back to the entry type.
const {
  Content,
  remarkPluginFrontmatter: { _codeBlockDetected = false, _mermaidDetected = false },
} = await render(post as unknown as BlogEntry)
---

<Layout>
  <Seo
    slot="meta"
    title={post.data.title}
    description={post.data.description}
    image={post.data.image}
    article={{
      published_time: post.data.date,
      modified_time: post.data.update,
    }}
    robots={post.data.date ? undefined : 'noindex'}
  />

  <div class="mx-auto max-w-2xl @container">
    {
      !!post.data.image && (
        <Image
          src={post.data.image}
          alt={`${post.data.title} header image`}
          class="aspect-4/1 w-full rounded-2xl object-cover object-top ring-1 ring-white/10"
          loading="eager"
        />
      )
    }

    <header class="mt-8 mb-10">
      <h1 class="text-4xl font-semibold tracking-tight text-zinc-50">{post.data.title}</h1>
      <div class="mt-3">
        {
          !post.data.date ? (
            <span class="rounded-full bg-red-500/10 px-2 py-0.5 text-xs font-medium text-red-400">Draft</span>
          ) : (
            <time class="font-mono text-sm text-zinc-500" datetime={post.data.date!.toISO()}>
              {post.data.date!.toFormat('yyyy-LL-dd')}
            </time>
          )
        }
      </div>
    </header>

    <article class="prose max-w-none">
      <Content />
    </article>
  </div>

  {_codeBlockDetected && <script src="~/lib/satteri/code-copy/client.js" />}
  {_mermaidDetected && <script src="~/lib/satteri/mermaid/client.js" />}
</Layout>
