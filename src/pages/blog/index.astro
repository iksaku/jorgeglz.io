---
import Layout from '~/layouts/Blog.astro'
import Seo from '~/components/Seo.astro'
import { type BlogPost, getBlogPosts } from '~/lib/utils'

const posts: BlogPost[] = await getBlogPosts((post) => import.meta.env.DEV || !!post.data.date)

const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'JorgeGlz',
  url: new URL('/', Astro.site ?? Astro.url).toString(),
}
---

<Layout>
  <Seo slot="meta" />
  <script slot="meta" is:inline type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} />

  <div class="mx-auto flex max-w-2xl flex-col gap-3">
    {
      posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          rel="prefetch"
          class="group block rounded-2xl bg-white/[0.03] p-6 ring-1 ring-white/10 transition-colors hover:bg-white/[0.06] hover:ring-white/20"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-base font-medium text-zinc-50">{post.data.title}</h2>
            {!post.data.date ? (
              <span class="shrink-0 rounded-full bg-red-500/10 px-2 py-0.5 text-xs font-medium text-red-400">
                Draft
              </span>
            ) : (
              <time class="shrink-0 font-mono text-sm text-zinc-500" datetime={post.data.date!.toISO()}>
                {post.data.date!.toFormat('yyyy-LL-dd')}
              </time>
            )}
          </div>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">{post.data.description}</p>
        </a>
      ))
    }
  </div>
</Layout>
