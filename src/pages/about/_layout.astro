---
import Layout from '~/layouts/Blog.astro'
import Seo from '~/components/Seo.astro'
import { Image } from 'astro:assets'
import Avatar from '~/assets/avatar.jpeg'
---

<Layout>
  <Seo slot="meta" title="About Me" description="Wanna know a little more about me?" />

  <div class="mx-auto max-w-2xl space-y-10">
    <div class="flex w-full flex-col-reverse items-center justify-center gap-6 md:flex-row md:justify-start">
      <Image
        src={Avatar}
        alt="Jorge González's Avatar"
        class="aspect-square size-32 overflow-hidden rounded-full ring-1 ring-white/10"
        loading="eager"
      />
      <h1 class="text-4xl font-semibold tracking-tight text-zinc-50">This is me... 🎶</h1>
    </div>

    <article class="prose max-w-none">
      <slot />
    </article>
  </div>
</Layout>
